[Unit]
Description=wayshare Screen Sharing server
# Needs the Wayland session (capture, virtual input, Hyprland IPC).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/wayshare
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
